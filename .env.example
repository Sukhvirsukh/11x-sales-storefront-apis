# ── Server ────────────────────────────────────────────────
NODE_ENV=development
# 11xsales-be runs on 5000; this API defaults to 5100 so both run side by side.
PORT=5100
API_PREFIX=/api/v1
# Processes serving requests: a number, or "auto" for one per CPU core.
CLUSTER_WORKERS=1
# Reverse proxies in front of the API; production defaults to 1 (Caddy) so rate limits see client IPs.
TRUST_PROXY_HOPS=
BODY_LIMIT_BYTES=1048576
KEEP_ALIVE_TIMEOUT_MS=72000

# ── Database (PostgreSQL) — the SAME database as 11xsales-be ─────
# Copy these from 11xsales-be/.env. This API never runs migrations; 11xsales-be owns the schema.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=elevenx_sales
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=false
DB_SSL=false
DB_SSL_CA_FILE=
# Optional read replica: all reads go here when set (writes stay on DB_HOST).
DB_READ_HOST=
DB_READ_PORT=
# Per process — total connections = DB_POOL_MAX × CLUSTER_WORKERS × instances.
DB_POOL_MAX=20
DB_POOL_WARM=4
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=3000

# ── Cache ─────────────────────────────────────────────────
# Shared L2 cache + invalidation bus. Leave empty for the in-process cache only.
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=sf:
REDIS_COMMAND_TIMEOUT_MS=50
CACHE_L1_MAX_ENTRIES=50000
CACHE_L1_MAX_TTL_SECONDS=30
CACHE_NEGATIVE_TTL_SECONDS=30

# ── Auth ──────────────────────────────────────────────────
# MUST be the same value as JWT_SECRET in 11xsales-be/.env (tokens are issued there, verified here).
JWT_SECRET=change-this-to-the-same-secret-as-11xsales-be
# Seconds an API key / widget key lookup is trusted before re-reading it.
AUTH_CACHE_TTL_SECONDS=60
API_KEY_USAGE_FLUSH_MS=60000
# Service-to-service token — the same INTERNAL_API_TOKEN as 11xsales-be. /internal/v1 is off when empty.
INTERNAL_API_TOKEN=

# ── Rate limiting (per client IP, per process) ───────────
RATE_LIMIT_MAX=1200
RATE_LIMIT_WINDOW_MS=60000

# ── CORS ──────────────────────────────────────────────────
# Storefronts are on any shop domain, so "*" by default; each agent's widget_allowed_origins is enforced per request.
CORS_ORIGINS=*

# ── Logging (on-premises / local disk) ───────────────────
LOG_DIR=logs
LOG_LEVEL=info
