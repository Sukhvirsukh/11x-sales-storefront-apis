{
  "name": "11x-sales-storefront-apis",
  "version": "1.0.0",
  "description": "11xSales storefront API — read-optimized, low-latency layered API (controller/service/repository) over the shared 11xsales-be database, with two-tier caching and API-key / JWT / widget-key / service-token auth.",
  "main": "dist/server.js",
  "private": true,
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-test.mjs",
    "bench": "node scripts/bench.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "dotenv": "^16.6.1",
    "fast-jwt": "^6.3.4",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.1",
    "lru-cache": "^11.5.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-roll": "^4.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "autocannon": "^8.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.7",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
